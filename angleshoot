index.html.
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AngleShot | Photography Guide</title>

  <!-- CSS -->
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, sans-serif;
      background: #171514;
      color: #f1ede7;
      line-height: 1.7;
    }

    :root {
      --gold: #c7a77a;
      --dark: #171514;
      --panel: #211d1a;
      --cream: #f1ede7;
    }

    header {
      padding: 20px 8%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: var(--dark);
      border-bottom: 1px solid #403832;
      position: sticky;
      top: 0;
      z-index: 10;
    }

    .logo {
      font-size: 23px;
      font-weight: bold;
      letter-spacing: 3px;
    }

    .logo span {
      color: var(--gold);
    }

    nav a {
      color: var(--cream);
      text-decoration: none;
      margin-left: 18px;
      font-size: 13px;
    }

    nav a:hover {
      color: var(--gold);
    }

    section {
      padding: 80px 8%;
      scroll-margin-top: 75px;
    }

    .welcome {
      min-height: 560px;
      display: flex;
      align-items: center;
      background:
        linear-gradient(90deg, #171514f2, #17151470),
        url("https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=1600&q=85")
        center/cover;
    }

    .welcome-content {
      max-width: 650px;
    }

    .label {
      color: var(--gold);
      text-transform: uppercase;
      letter-spacing: 3px;
      font-size: 12px;
    }

    h1 {
      font-size: clamp(42px, 7vw, 76px);
      line-height: 1.05;
      margin: 20px 0;
    }

    h2 {
      font-size: 35px;
      margin: 12px 0 20px;
    }

    .gold {
      color: var(--gold);
    }

    p {
      color: #c6beb5;
      margin-bottom: 20px;
    }

    .button {
      display: inline-block;
      padding: 12px 22px;
      background: var(--gold);
      color: #171514;
      text-decoration: none;
      font-weight: bold;
      margin: 8px 8px 0 0;
      border: 1px solid var(--gold);
    }

    .button:hover {
      background: transparent;
      color: var(--gold);
    }

    .button-outline {
      background: transparent;
      color: var(--cream);
      border-color: #716355;
    }

    .about-layout {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 40px;
      align-items: center;
    }

    .about-layout img {
      width: 100%;
      height: 350px;
      object-fit: cover;
    }

    .services,
    .portfolio,
    .faq {
      background: var(--panel);
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      margin-top: 30px;
    }

    .card {
      background: #29231f;
      border: 1px solid #403832;
      padding: 22px;
      transition: 0.25s;
    }

    .card:hover {
      transform: translateY(-5px);
      border-color: var(--gold);
    }

    .card h3 {
      margin-bottom: 10px;
    }

    .card p {
      font-size: 14px;
      margin-bottom: 0;
    }

    .portfolio .card {
      padding: 0;
      overflow: hidden;
    }

    .portfolio img {
      width: 100%;
      height: 210px;
      object-fit: cover;
    }

    .portfolio .card-content {
      padding: 20px;
    }

    .reason {
      padding: 18px 0;
      border-bottom: 1px solid #403832;
    }

    details {
      padding: 18px 0;
      border-bottom: 1px solid #403832;
    }

    summary {
      cursor: pointer;
      font-weight: bold;
    }

    details p {
      margin: 12px 0 0;
    }

    .contact-layout {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 35px;
    }

    input, textarea {
      width: 100%;
      padding: 13px;
      margin: 6px 0 15px;
      background: #171514;
      border: 1px solid #55483c;
      color: white;
      font: inherit;
    }

    textarea {
      min-height: 120px;
      resize: vertical;
    }

    button {
      cursor: pointer;
      font: inherit;
    }

    footer {
      padding: 30px 8%;
      background: #100f0e;
      border-top: 1px solid #403832;
      text-align: center;
    }

    footer p {
      margin: 8px 0;
      font-size: 13px;
    }

    @media (max-width: 750px) {
      header {
        padding: 18px 5%;
        flex-wrap: wrap;
        gap: 15px;
      }

      nav {
        display: none;
        width: 100%;
      }

      nav.open {
        display: flex;
        flex-direction: column;
        gap: 12px;
      }

      nav a {
        margin: 0;
      }

      .menu-button {
        display: block;
      }

      section {
        padding: 60px 6%;
      }

      .about-layout,
      .contact-layout {
        grid-template-columns: 1fr;
      }

      .grid {
        grid-template-columns: 1fr;
      }

      h2 {
        font-size: 29px;
      }
    }

    @media (min-width: 751px) {
      .menu-button {
        display: none;
      }
    }
  </style>
</head>

<body>

  <!-- NAVIGATION -->
  <header>
    <a class="logo" href="#home" style="color:inherit;text-decoration:none">
      ANGLE<span>SHOT</span>
    </a>

    <button class="button menu-button" id="menuButton">
      ☰ Menu
    </button>

    <nav id="navigation">
      <a href="#home">Home</a>
      <a href="#about">About Us</a>
      <a href="#services">Services</a>
      <a href="#portfolio">Portfolio</a>
      <a href="#why">Why Us?</a>
      <a href="#faq">FAQ</a>
      <a href="#contact">Contact</a>
    </nav>
  </header>

  <!-- WELCOME PAGE -->
  <section class="welcome" id="home">
    <div class="welcome-content">
      <div class="label">Photography Inspiration</div>

      <h1>
        See It From<br>
        A <span class="gold">Different Angle.</span>
      </h1>

      <p>
        Setiap sudut memiliki cerita.
        Temukan rekomendasi angle fotografi,
        teknik komposisi, dan inspirasi visual
        untuk menghasilkan foto yang lebih menarik.
      </p>

      <a class="button" href="#services">Explore Angles →</a>
      <a class="button button-outline" href="#portfolio">
        View Portfolio
      </a>
    </div>
  </section>

  <!-- ABOUT US -->
  <section id="about">
    <div class="about-layout">
      <img
        src="https://images.unsplash.com/photo-1452587925148-ce544e77e70d?auto=format&fit=crop&w=1000&q=85"
        alt="Fotografi dan kamera"
        loading="lazy"
      >

      <div>
        <div class="label">About AngleShot</div>
        <h2>Photography Is About <span class="gold">Perspective.</span></h2>

        <p>
          AngleShot adalah platform inspirasi fotografi
          yang membantu siapa saja memahami berbagai
          sudut pengambilan gambar dan komposisi visual.
        </p>

        <p>
          Kami percaya foto yang menarik tidak selalu
          bergantung pada kamera mahal. Perspektif,
          kreativitas, dan keberanian mencoba sudut baru
          juga memiliki peran penting.
        </p>

        <a class="button" href="#services">Learn More →</a>
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="services" id="services">
    <div class="label">What We Offer</div>
    <h2>Explore Our <span class="gold">Services.</span></h2>

    <p>
      Panduan sederhana untuk membantumu
      mengembangkan kemampuan fotografi.
    </p>

    <div class="grid">
      <div class="card">
        <h3>01. Angle Guide</h3>
        <p>
          Pelajari eye-level, high angle, low angle,
          bird's-eye view, dan perspektif lainnya.
        </p>
      </div>

      <div class="card">
        <h3>02. Composition</h3>
        <p>
          Kenali rule of thirds, leading lines,
          framing, symmetry, dan negative space.
        </p>
      </div>

      <div class="card">
        <h3>03. Photography Tips</h3>
        <p>
          Temukan tips tentang pencahayaan,
          posisi kamera, dan pengaturan komposisi.
        </p>
      </div>
    </div>
  </section>

  <!-- PORTFOLIO -->
  <section class="portfolio" id="portfolio">
    <div class="label">Visual Inspiration</div>
    <h2>Our <span class="gold">Portfolio.</span></h2>

    <p>
      Contoh visual untuk mengeksplorasi
      berbagai pendekatan fotografi.
    </p>

    <div class="grid">
      <div class="card">
        <img
          src="https://images.unsplash.com/photo-1500534623283-312aade485b7?auto=format&fit=crop&w=800&q=85"
          alt="Fotografi lanskap"
          loading="lazy"
        >
        <div class="card-content">
          <h3>Landscape</h3>
          <p>Eksplorasi perspektif dan ruang dalam lanskap.</p>
        </div>
      </div>

      <div class="card">
        <img
          src="https://images.unsplash.com/photo-1518005020951-eccb494ad742?auto=format&fit=crop&w=800&q=85"
          alt="Fotografi arsitektur"
          loading="lazy"
        >
        <div class="card-content">
          <h3>Architecture</h3>
          <p>Manfaatkan garis dan sudut bangunan.</p>
        </div>
      </div>

      <div class="card">
        <img
          src="https://images.unsplash.com/photo-1490750967868-88aa4486c946?auto=format&fit=crop&w=800&q=85"
          alt="Fotografi bunga"
          loading="lazy"
        >
        <div class="card-content">
          <h3>Close-up</h3>
          <p>Tonjolkan detail kecil dari objek.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY CHOOSE ANGLESHOT -->
  <section id="why">
    <div class="label">Why Choose AngleShot?</div>
    <h2>See More. <span class="gold">Create More.</span></h2>

    <p>
      Kami ingin membuat proses belajar fotografi
      lebih mudah, praktis, dan menyenangkan.
    </p>

    <div class="reason">
      <h3>✦ Easy to Understand</h3>
      <p>Penjelasan ringkas yang ramah untuk pemula.</p>
    </div>

    <div class="reason">
      <h3>✦ Visual Learning</h3>
      <p>Belajar melalui referensi dan contoh visual.</p>
    </div>

    <div class="reason">
      <h3>✦ Smartphone Friendly</h3>
      <p>Kamu bisa mulai berlatih dengan smartphone.</p>
    </div>

    <div class="reason">
      <h3>✦ Creative Perspective</h3>
      <p>Temukan gaya dan sudut pandangmu sendiri.</p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq" id="faq">
    <div class="label">Frequently Asked Questions</div>
    <h2>Questions & <span class="gold">Answers.</span></h2>

    <details>
      <summary>Apa itu AngleShot?</summary>
      <p>
        Website inspirasi fotografi yang membahas
        rekomendasi angle, komposisi, dan teknik visual.
      </p>
    </details>

    <details>
      <summary>Apakah cocok untuk pemula?</summary>
      <p>
        Ya. Materinya dirancang agar mudah dipahami
        dan bisa langsung dicoba.
      </p>
    </details>

    <details>
      <summary>Apakah harus punya kamera profesional?</summary>
      <p>
        Tidak. Smartphone juga bisa digunakan untuk
        mempelajari angle dan komposisi.
      </p>
    </details>

    <details>
      <summary>Angle apa yang sebaiknya dipelajari dahulu?</summary>
      <p>
        Mulailah dari eye-level, high angle, dan low angle,
        lalu coba teknik komposisi lainnya.
      </p>
    </details>
  </section>

  <!-- CONTACT US -->
  <section id="contact">
    <div class="contact-layout">
      <div>
        <div class="label">Contact Us</div>
        <h2>Let's Start a <span class="gold">Conversation.</span></h2>

        <p>
          Punya pertanyaan, saran, atau inspirasi fotografi?
          Hubungi kami melalui formulir di samping.
        </p>

        <p>Email: hello@angleshot.example</p>
        <p>Instagram: @angleshot</p>
        <p style="font-size:13px">
          Ganti email dan username di atas dengan
          informasi milikmu sendiri.
        </p>
      </div>

      <form id="contactForm">
        <label for="name">Nama</label>
        <input id="name" name="name" placeholder="Nama kamu" required>

        <label for="email">Email</label>
        <input id="email" name="email" type="email"
               placeholder="nama@email.com" required>

        <label for="message">Pesan</label>
        <textarea id="message" name="message"
                  placeholder="Tulis pesan kamu..." required></textarea>

        <button class="button" type="submit">Kirim Pesan →</button>
      </form>
    </div>
  </section>

  <!-- FOOTER -->
  <footer>
    <div class="logo">ANGLE<span>SHOT</span></div>
    <p>See the world from a different angle.</p>
    <p>
      <a href="#home">Home</a> ·
      <a href="#about">About Us</a> ·
      <a href="#services">Services</a> ·
      <a href="#portfolio">Portfolio</a> ·
      <a href="#contact">Contact</a>
    </p>
    <p>© <span id="year"></span> AngleShot. All rights reserved.</p>
  </footer>

  <!-- JAVASCRIPT -->
  <script>
    // Menu navigasi untuk layar HP
    const menuButton = document.getElementById("menuButton");
    const navigation = document.getElementById("navigation");

    menuButton.addEventListener("click", function () {
      navigation.classList.toggle("open");
    });

    navigation.querySelectorAll("a").forEach(function (link) {
      link.addEventListener("click", function () {
        navigation.classList.remove("open");
      });
    });

    // Tahun footer otomatis
    document.getElementById("year").textContent =
      new Date().getFullYear();

    // Form kontak: membuka aplikasi email
    // GANTI dengan alamat email tujuanmu.
    const destinationEmail = "hello@angleshot.example";

    document.getElementById("contactForm")
      .addEventListener("submit", function (event) {
        event.preventDefault();

        const form = new FormData(this);
        const name = form.get("name");
        const email = form.get("email");
        const message = form.get("message");

        const subject = encodeURIComponent(
          "Pesan dari website AngleShot - " + name
        );

        const body = encodeURIComponent(
          "Nama: " + name +
          "\nEmail: " + email +
          "\n\nPesan:\n" + message
        );

        window.location.href =
          "mailto:" + destinationEmail +
          "?subject=" + subject +
          "&body=" + body;
      });
  </script>

</body>
</html>
